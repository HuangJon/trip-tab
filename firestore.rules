rules_version = '2';
// Only accounts with a verified email get in: Google accounts, or email accounts after tapping the link.
// Opening a trip's link records the account in joined/{uid}, and an admin can remove anyone from there.
// A name on a trip belongs to the account that claimed it, recorded in claims/{memberId}.
// Every write says which name is making it, and that name has to belong to this account.
// Only the app's owner can list trips. The owner gets reading only, with no extra power to change anything.
// Nothing can be deleted except an entry on your own trip list.
// Rules can't add up a map, so the app also checks that each expense's shares reach its total.
service cloud.firestore {
  match /databases/{database}/documents {
    // The app's owner. Testing swaps in a test address when publishing to the staging project only.
    function isOwner() { return request.auth != null && request.auth.token.email_verified == true && request.auth.uid == '80zN7EdZTZOZ8RGVWLmUcMAgetk2'; }
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function okId(id) { return id.matches('^[a-z0-9]{10,40}$'); }
    function okTripId(id) { return signedIn() && id.matches('^[a-z0-9]{20,40}$'); }
    function short(value, limit) { return value is string && value.size() <= limit; }

    function tripPath(tripId) { return /databases/$(database)/documents/trips/$(tripId); }
    function claimPath(tripId, memberId) { return /databases/$(database)/documents/trips/$(tripId)/claims/$(memberId); }
    function joinedPath(tripId) { return /databases/$(database)/documents/trips/$(tripId)/joined/$(request.auth.uid); }
    // On the trip: this account has opened it, and no admin has removed it.
    function onTrip(tripId) {
      return exists(joinedPath(tripId)) && get(joinedPath(tripId)).data.removed != true;
    }
    // Reads can't say which name they're for, so this list of accounts decides who can see the joined list.
    function isAdminAccount(tripId) {
      return get(tripPath(tripId)).data.adminUids.get(request.auth.uid, false) == true;
    }
    function isMe(tripId, memberId) {
      return memberId is string && memberId.size() > 0
        && onTrip(tripId)
        && exists(claimPath(tripId, memberId))
        && get(claimPath(tripId, memberId)).data.uid == request.auth.uid;
    }
    function isAdmin(tripId, memberId) {
      return isMe(tripId, memberId) && get(tripPath(tripId)).data.admins.get(memberId, false) == true;
    }

    function isTripCreator(tripId) { return isAdminAccount(tripId); }

    function validTrip(d, tripId) {
      return d.id == tripId
        && short(d.name, 60) && d.name.size() > 0
        && d.currency.matches('^[A-Z]{3}$')
        && d.members is map && d.members.size() >= 1 && d.members.size() <= 200
        && d.admins is map && d.admins.size() >= 1 && d.admins.size() <= 200
        && d.rates is map && d.rates.size() <= 40
        && d.simplify is bool;
    }

    function validEntry(d, id, tripId) {
      return d.id == id && d.tripId == tripId
        && d.kind in ['expense', 'payment', 'refund']
        && d.total is int && d.total > 0 && d.total <= 1000000000000
        && d.currency.matches('^[A-Z]{3}$')
        && (d.rate == null || (d.rate is number && d.rate > 0))
        && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && short(d.desc, 80) && d.desc.size() > 0
        && short(d.note, 500)
        && short(d.category, 30)
        && d.deleted is bool
        && d.updatedAt is number
        && d.paid is map && d.paid.size() >= 1 && d.paid.size() <= 200
        && d.owed is map && d.owed.size() >= 1 && d.owed.size() <= 200
        && d.comments is map && d.comments.size() <= 500
        && (d.kind != 'payment' || (d.paid.size() == 1 && d.owed.size() == 1));
    }

    // A comment can be added by anyone on the trip, and changed or removed only by whoever wrote it.
    // Each write names the one comment it touches, and nothing is ever taken out of the list.
    function commentOk(tripId) {
      let d = request.resource.data;
      let actor = d.get('commentedBy', '');
      let k = d.get('commentId', '');
      let change = d.comments.diff(resource.data.comments);
      return isMe(tripId, actor) && k is string && k.size() > 0
        && change.affectedKeys().hasOnly([k]) && change.removedKeys().size() == 0
        && d.comments[k].byId == actor && short(d.comments[k].text, 500)
        && (!(k in resource.data.comments) || resource.data.comments[k].get('byId', '') == actor);
    }

    // Who can change an existing expense: whoever added it, whoever handled the money, or an admin.
    function canChange(tripId, old, actor) {
      return isAdmin(tripId, actor) || (isMe(tripId, actor) && (
        old.get('createdById', '') == actor
        || (old.kind != 'refund' && old.paid.keys().hasAny([actor]))
        || (old.kind == 'refund' && old.owed.keys().hasAny([actor]))
      ));
    }

    // Your own list of trips, which follows you to any device.
    match /users/{uid}/trips/{tripId} {
      allow read, delete: if signedIn() && uid == request.auth.uid;
      allow create, update: if signedIn() && uid == request.auth.uid && request.resource.data.tripId == tripId;
    }

    // A short note when something breaks. Anyone signed in can add their own; only the owner can read them.
    match /errorLog/{id} {
      allow read: if isOwner();
      allow create: if signedIn() && okId(id)
        && request.resource.data.keys().hasOnly(['id', 'kind', 'message', 'where', 'tripId', 'agent', 'uid', 'email', 'at'])
        && request.resource.data.keys().hasAll(['id', 'kind', 'message', 'where', 'tripId', 'agent', 'uid', 'email', 'at'])
        && request.resource.data.id == id
        && request.resource.data.kind in ['failed-save', 'app-error']
        && short(request.resource.data.message, 300)
        && short(request.resource.data.where, 100)
        && short(request.resource.data.tripId, 40)
        && short(request.resource.data.agent, 200)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.at is number;
      allow update, delete: if false;
    }

    match /trips/{tripId} {
      allow get: if okTripId(tripId) && (resource == null || onTrip(tripId) || isOwner());
      allow list: if isOwner();
      allow create: if okTripId(tripId) && validTrip(request.resource.data, tripId)
        && request.resource.data.adminUids.get(request.auth.uid, false) == true;
      allow update: if okTripId(tripId) && validTrip(request.resource.data, tripId)
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.members.size() >= resource.data.members.size()
        && (
          isAdmin(tripId, request.resource.data.changedBy)
          // Everyone else changes only their own name, Venmo and Zelle, and adds rates for new currencies.
          // Only an admin changes or removes a rate. No admin lists change here, so nobody can promote themselves.
          || (isMe(tripId, request.resource.data.changedBy)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'rates', 'changedBy'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.resource.data.changedBy])
            && request.resource.data.rates.diff(resource.data.rates).changedKeys().size() == 0
            && request.resource.data.rates.diff(resource.data.rates).removedKeys().size() == 0)
        );
      allow delete: if false;

      match /joined/{uid} {
        allow get: if okTripId(tripId) && (uid == request.auth.uid || isAdminAccount(tripId) || isOwner());
        allow list: if okTripId(tripId) && (isAdminAccount(tripId) || isOwner());
        allow create: if okTripId(tripId) && uid == request.auth.uid
          && request.resource.data.uid == uid
          && request.resource.data.tripId == tripId
          && request.resource.data.removed == false
          && short(request.resource.data.displayName, 80)
          && short(request.resource.data.email, 200)
          // The name comes from a real claim, or is empty until one is made.
          && (request.resource.data.memberId == null || isTripCreator(tripId));
        allow update: if okTripId(tripId) && (
          isAdminAccount(tripId)
          // Your own record can only change which name you hold, and that name has to be yours.
          || (uid == request.auth.uid && resource.data.removed != true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberId'])
            && (request.resource.data.memberId == null || isMe(tripId, request.resource.data.memberId)))
        );
        allow delete: if false;
      }

      match /claims/{memberId} {
        allow get: if okTripId(tripId) && onTrip(tripId);
        allow list: if false;
        allow create: if okTripId(tripId) && okId(memberId)
          && (onTrip(tripId) || isTripCreator(tripId))
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.memberId == memberId
          && request.resource.data.tripId == tripId;
        allow update: if okTripId(tripId) && (
          // Claiming a freed name.
          (resource.data.released == true && onTrip(tripId)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.released == false
            && request.resource.data.memberId == resource.data.memberId
            && request.resource.data.tripId == resource.data.tripId)
          // An admin freeing the name.
          || (isAdmin(tripId, request.resource.data.releasedBy)
            && request.resource.data.released == true
            && request.resource.data.uid == ''
            && request.resource.data.memberId == resource.data.memberId
            && request.resource.data.tripId == resource.data.tripId)
        );
        allow delete: if false;
      }

      match /entries/{id} {
        allow read: if okTripId(tripId) && (onTrip(tripId) || isOwner());
        allow create: if okTripId(tripId) && okId(id) && validEntry(request.resource.data, id, tripId)
          && (isAdmin(tripId, request.resource.data.updatedById)
            || (isMe(tripId, request.resource.data.updatedById)
              && request.resource.data.createdById == request.resource.data.updatedById));
        allow update: if okTripId(tripId) && okId(id) && validEntry(request.resource.data, id, tripId)
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('createdById', '') == resource.data.get('createdById', '')
          && request.resource.data.comments.size() >= resource.data.comments.size()
          && (
            // Editing the expense leaves its comments alone.
            (canChange(tripId, resource.data, request.resource.data.get('updatedById', ''))
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['comments']))
            || (commentOk(tripId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'commentedBy', 'commentId']))
          );
        allow delete: if false;

        match /revisions/{revId} {
          allow read: if okTripId(tripId) && onTrip(tripId);
          allow create: if okTripId(tripId) && okId(revId)
            && isMe(tripId, request.resource.data.byId)
            && request.resource.data.tripId == tripId
            && request.resource.data.entryId == id
            && short(request.resource.data.by, 60)
            && request.resource.data.at is number
            && request.resource.data.entry is map;
          allow update, delete: if false; // history can't be rewritten
        }
      }
      match /activity/{id} {
        allow read: if okTripId(tripId) && (onTrip(tripId) || isOwner());
        allow create: if okTripId(tripId) && okId(id)
          && isMe(tripId, request.resource.data.byId)
          && request.resource.data.tripId == tripId
          && short(request.resource.data.text, 400)
          && request.resource.data.at is number;
        allow update, delete: if false;
      }
      match /receipts/{id} {
        allow get: if okTripId(tripId) && (onTrip(tripId) || isOwner());
        allow list: if false; // receipts load one at a time, only when someone opens one
        allow create: if okTripId(tripId) && okId(id)
          && isMe(tripId, request.resource.data.byId)
          && short(request.resource.data.dataUrl, 800000)
          && request.resource.data.dataUrl.matches('^data:image/jpeg;base64,.*');
        allow update, delete: if false;
      }
    }
  }
}
